FROM parser_image
USER root
COPY requirements.ocr.lock /tmp/requirements.ocr.lock
RUN uv pip install --python /app/.venv/bin/python -r /tmp/requirements.ocr.lock
COPY scripts/prepare_ocr.py scripts/prepare_paddle.py /tmp/
RUN /app/.venv/bin/python /tmp/prepare_ocr.py && /app/.venv/bin/python /tmp/prepare_paddle.py && chmod -R a+rX /opt/ocr-models
USER app