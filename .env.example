DJANGO_SECRET_KEY=replace-with-random-secret
MICE_DB_PASSWORD=replace-with-random-db-password
MICE_RABBIT_PASSWORD=replace-with-url-safe-random-password
ADMIN_PASSWORD=replace-with-at-least-16-random-characters
MICE_COOKIE_SECURE=false
MICE_ML_INFERENCE_ENABLED=false
MICE_LLM_INFERENCE_ENABLED=false
# Recommended unified preload/fork architecture; preserves queued legacy jobs.
MICE_UNIFIED_ANALYSIS_ENABLED=true
MICE_PARSER_CONCURRENCY=2
MICE_SANDBOX_ADDRESS_LIMIT_MIB=1024
MICE_ANALYSIS_CONCURRENCY=2
MICE_ANALYSIS_PREFETCH=1
MICE_PARSER_QUEUE_SIZE=3
MICE_PARSER_SLOT_WAIT_SECONDS=5
MICE_ANALYSIS_WALL_TIMEOUT=600
MICE_ANALYSIS_TIMEOUT=720
