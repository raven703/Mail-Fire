POSTGRES_PASSWORD=replace-with-a-random-database-password
ADMIN_PASSWORD=replace-with-a-random-admin-password
COOKIE_SECURE=false
IMPORT_POLICY=leave
SMTP_NETWORKS=127.0.0.1/32
INTERNAL_DOMAINS=example.test
# Optional local neural inference/training (see compose.ml.yaml).
# One complete cointegrated/rubert-tiny2 snapshot in data/models/rubert/
# is reused for RuBERT fine-tuning AND SetFit by default. No LLM is needed.
# Optional: ML_SETFIT_BASE_PATH=/opt/local-ml/setfit (different encoder)
